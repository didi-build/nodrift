{
  "name": "@didi-build/nodrift",
  "version": "0.2.0",
  "description": "Keeps privacy docs from drifting from the code.",
  "license": "MIT",
  "author": "Didi Build",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/didi-build/nodrift.git"
  },
  "bugs": {
    "url": "https://github.com/didi-build/nodrift/issues"
  },
  "homepage": "https://github.com/didi-build/nodrift#readme",
  "keywords": [
    "privacy",
    "pipeda",
    "compliance",
    "data-map",
    "cloudflare",
    "d1"
  ],
  "type": "module",
  "files": [
    "dist",
    "templates",
    "LICENSE",
    "LICENSES",
    "README.md"
  ],
  "exports": {
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "nodrift": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run secrets && npm run secret-usage && npm run placeholders && npm run attribution",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "package:check": "node scripts/check-package.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "secrets": "secretlint \"**/*\"",
    "secret-usage": "node scripts/check-secret-usage.mjs",
    "placeholders": "node scripts/check-placeholders.mjs",
    "attribution": "node scripts/check-attribution.mjs",
    "init-project": "node scripts/init-project.mjs",
    "repo-settings": "node scripts/repo-settings.mjs",
    "verify-action-pins": "node scripts/verify-action-pins.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@secretlint/secretlint-rule-preset-recommend": "10.2.2",
    "@types/node": "22.20.5",
    "eslint": "9.37.0",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.10",
    "secretlint": "10.2.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "yaml": "2.9.1"
  }
}
